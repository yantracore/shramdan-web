  "comments": {
    "issue:shankhamul-bagmati-plastic": [
      {
        "id": "7cb2310f-02c1-4ae1-96db-acebf671059d",
        "memberSlug": "arjun",
        "text": "यो स्थानमा हामीले पहिले पनि अभियान चलाएका थियौँ — स्थायी समाधान चाहिएको हो। साइनबोर्डले मात्र पुग्दैन।"
      },
      {
        "id": "0685ff80-df01-4def-885b-beb49172a2dc",
        "memberSlug": "priya",
        "text": "मनसुनको पानी सँगै आउने प्लास्टिक रोक्न ने माथिल्लो खण्डमा छाननी लगाउनुपर्छ। नगरपालिकालाई सिफारिस गरौँ।"
      },
      {
        "id": "98ad4206-78e3-43da-9d9f-4e16b4a75de5",
        "memberSlug": "bishnu",
        "text": "अग्रिम अभियान चलाउनु अघि बासिन्दा बैठक राख्ने सुझाव।"
      },
      {
        "id": "b0def9fc-5533-42b8-b076-ecf2d4b3e193",
        "memberSlug": "sita",
        "text": "मेरो परिवारका सबै सहभागी हुन तयार छन्। शनिबार उपयुक्त हुनेछ।"
      }
    ],
    "issue:boudha-ring-road-trash": [
      {
        "id": "cb2ec2ba-2218-4fb8-83c6-e2825fc631f0",
        "memberSlug": "ramesh",
        "text": "मैले हिजो विडियो गरें — दृश्य साँच्चै खराब छ। टायर र पुराना सिमेन्ट पनि छन्।"
      },
      {
        "id": "5ad62412-d78d-44c8-992e-8fc040433588",
        "memberSlug": "bishnu",
        "text": "नगरपालिकाको ट्रक के बेला आउँछ निश्चित गरौँ — नभए सङ्कलित फोहोर त्यहीँ नै बस्छ।"
      },
      {
        "id": "768eeb80-d7ee-4a96-baeb-efec8b1bdf72",
        "memberSlug": "maya",
        "text": "व्यापार सङ्घले स्वयंसेवक पनि ल्याउने भनेका छन् भन्ने सुनेँ।"
      }
    ],
    "issue:asan-main-bazaar-blocked": [
      {
        "id": "35374805-01d3-46ac-869d-f709fdece1d8",
        "memberSlug": "hari",
        "text": "असनमा बजार खण्ड मेरो दैनिक हिँडाइको बाटो — एकदम साँचो प्रश्न उठाइएको।"
      },
      {
        "id": "d78b410e-80a8-4c92-952d-b2824f05dfb6",
        "memberSlug": "arjun",
        "text": "व्यापारीहरूसँग पनि कुरा गर्नुपर्ने हुन्छ; जबरजस्ती हटाउँदा उल्टो प्रभाव पर्न सक्छ।"
      },
      {
        "id": "ee7b6400-bcfe-43ef-a355-f03eb71cb049",
        "memberSlug": "priya",
        "text": "बजार समितिको सहयोग बिना यो सम्भव छैन। पहिले उहाँहरूसँग भेट तय गरौँ।"
      }
    ],
    "issue:traffic-chowk-drain-jam": [
      {
        "id": "9b1bebf7-bbba-4805-bcf5-e3b765c2d533",
        "memberSlug": "bikash",
        "text": "मनसुन सुरु हुनुअघि नै काम सकाउनुपर्छ। ढिलाइ गर्न मिल्दैन।"
      },
      {
        "id": "85f3a379-1caa-41a8-aa5d-ec6091d5ba2a",
        "memberSlug": "ramesh",
        "text": "नगरपालिकाको इन्जिनियरिङ शाखासँग छलफल भएको छ कि छैन?"
      },
      {
        "id": "f0186965-2e35-40a9-9a6e-f2d8ddfdb537",
        "memberSlug": "bishnu",
        "text": "ढल मर्मत स्वयंसेवकको कामभन्दा प्राविधिक टोलीको हो जस्तो लाग्छ।"
      }
    ],
    "issue:sarangkot-sunrise-trail-trash": [
      {
        "id": "18c7b95a-fc41-45c8-8f8e-35cf5767d0f7",
        "memberSlug": "maya",
        "text": "मैले पनि अघिल्लो साता हेरें — साँच्चै अव्यवस्थित। यात्रीहरूलाई पनि शिक्षा चाहिएको।"
      },
      {
        "id": "74ad7dc8-71cc-4683-bb84-e57e06668449",
        "memberSlug": "suman",
        "text": "स्थानीय गाइडसँग समन्वय गरेर हरेक १५ दिनमा छोटो सरसफाइ राख्ने सुझाव दिन्छु।"
      }
    ],
    "event:bagmati-tinkune-cleanup": [
      {
        "id": "62a9af2d-dea1-492d-beea-2cbb5b7148a4",
        "memberSlug": "arjun",
        "text": "टोली एकदम राम्रो आइरहेको छ। प्लास्टिक सङ्कलन पनि व्यवस्थित।"
      },
      {
        "id": "b4da73ca-676c-4cc1-bd37-d3ad27508f66",
        "memberSlug": "maya",
        "text": "तस्बिर खिच्ने ठाउँ राम्रो छ — पुलबाट र दक्षिणी किनारबाट दुवैतर्फ।"
      },
      {
        "id": "63054b19-ac5a-47e8-920c-3444ffbd2e4f",
        "memberSlug": "ramesh",
        "text": "लाइभ स्ट्रिम चलिरहेको छ; viewer count राम्रो छ।"
      },
      {
        "id": "34e45d8c-f0e3-4cb1-ac08-50439feb5c89",
        "memberSlug": "priya",
        "text": "सुरक्षा जोखिम भएको ठाउँमा साइनबोर्ड लगायौँ। पन्जा र मास्क सबैले लगाएका छन्।"
      },
      {
        "id": "7ba5086d-40f3-42eb-b2f5-f9e92e51174a",
        "memberSlug": "sita",
        "text": "पहिलो दिन यतिकै सहभागी आउँदा साँच्चै राम्रो लागिरहेको छ।"
      }
    ],
    "event:kamalpokhari-beautification": [
      {
        "id": "e832aea8-07f5-492e-ad80-41cc8c0356b7",
        "memberSlug": "bishnu",
        "text": "रङ चयन र डिजाइन एकदम राम्रो। स्थानीय कलाकारलाई धन्यवाद।"
      },
      {
        "id": "8087db99-18b4-481e-b2e6-2361910f02b5",
        "memberSlug": "maya",
        "text": "भित्ता चित्र क्षेत्र सकिनै लाग्यो; अगाडिको साइनबोर्ड पनि सुरु गरौँ।"
      },
      {
        "id": "abbe91f4-92e7-415d-95c4-f5ee0467d47e",
        "memberSlug": "ramesh",
        "text": "लाइभ चलिरहेको छ — कमेन्ट र likes राम्रो आइरहेका छन्।"
      }
    ],
    "event:suryabinayak-afforestation": [
      {
        "id": "22fbfeb0-520d-4054-b9a1-9f1ad53ea230",
        "memberSlug": "arjun",
        "text": "१०० बिरुवा सकियो; अब सुरक्षा घेरा हाल्न सुरु गर्दैछौँ।"
      },
      {
        "id": "ac7eeb31-e4d9-4770-939f-e72f57a5f73e",
        "memberSlug": "bishnu",
        "text": "मेडिकल टोली तयार छ। अहिलेसम्म कुनै दुर्घटना छैन।"
      },
      {
        "id": "1b5d28ea-4ee4-49fb-8e3b-239a612090c1",
        "memberSlug": "hari",
        "text": "साँच्चै थकिएको तर सन्तुष्ट छु। ३ महिनासम्म पानी हाल्ने जिम्मा मेरो।"
      }
    ],
    "event:hanumante-lokanthali-cleanup": [
      {
        "id": "13429204-c08d-4e72-8831-03a292b63f94",
        "memberSlug": "suman",
        "text": "तीन टोली नै बाँडिएका छन्; प्रगति राम्रो।"
      },
      {
        "id": "5a963aa7-a80f-4063-bab1-58beb0fba1ec",
        "memberSlug": "bishnu",
        "text": "साइनबोर्ड लगाउने ठाउँ चयन गरिसकेँ।"
      }
    ],
    "event:fewa-shoreline-cleanup": [
      {
        "id": "d3edd3d2-46f3-44ec-aef3-8fa43306b9b9",
        "memberSlug": "arjun",
        "text": "डुङ्गा टोली पानीको प्लास्टिक उठाउँदै छन्। राम्रो coordination।"
      },
      {
        "id": "ff7488a7-e58b-4202-b8fd-281a62dff68b",
        "memberSlug": "maya",
        "text": "तस्बिर र विडियो राम्रो भइरहेको छ — सूर्यास्त सम्ममा सकिने आशा।"
      },
      {
        "id": "122a940d-d4d5-4c28-9c74-f6b72f5b0c11",
        "memberSlug": "ramesh",
        "text": "लाइभ stream पर्यटकहरूको पनि ध्यान आकर्षण गरिरहेको छ।"
