    "event:suryabinayak-afforestation": [
      {
        "id": "22fbfeb0-520d-4054-b9a1-9f1ad53ea230",
        "memberSlug": "arjun",
        "text": "१०० बिरुवा सकियो; अब सुरक्षा घेरा हाल्न सुरु गर्दैछौँ।"
      },
      {
        "id": "ac7eeb31-e4d9-4770-939f-e72f57a5f73e",
        "memberSlug": "bishnu",
        "text": "मेडिकल टोली तयार छ। अहिलेसम्म कुनै दुर्घटना छैन।"
      },
      {
        "id": "1b5d28ea-4ee4-49fb-8e3b-239a612090c1",
        "memberSlug": "hari",
        "text": "साँच्चै थकिएको तर सन्तुष्ट छु। ३ महिनासम्म पानी हाल्ने जिम्मा मेरो।"
      },
      {
        "id": "248376d9-db73-4fce-874d-793b091ba566",
        "memberSlug": "deepika",
        "text": "११० बिरुवा लागेका छन् अहिले — चिलाउनेको line एकदम राम्रो देखिएको। बच्चाहरूले पनि खुसी मानेर रोप्दैछन्।",
        "parentId": null
      },
      {
        "id": "694e15a7-9e1b-497f-b29b-1d509929aeb6",
        "memberSlug": "arjun",
        "text": "बच्चाहरूको photo को permission ल पहिले लिँदा राम्रो। Maya, छ?",
        "parentId": "248376d9-db73-4fce-874d-793b091ba566"
      },
      {
        "id": "5f4709db-9221-4a88-83f8-eeb235db11d0",
        "memberSlug": "maya",
        "text": "लिएँ — सबै अभिभावकले सही दिएको form आज सबेरै हो।",
        "parentId": "248376d9-db73-4fce-874d-793b091ba566"
      },
      {
        "id": "84dc0a66-28fd-457c-81cd-55bc0ccbe3a9",
        "memberSlug": "arjun",
        "text": "Perfect. Continue गर्नुहोस्।",
        "parentId": "5f4709db-9221-4a88-83f8-eeb235db11d0"
      },
      {
        "id": "668d669b-6a30-47c9-8a83-8e503a612b91",
        "memberSlug": "rajiv",
        "text": "नगरपालिकाको technician आइसके — soil quality test को result २ हप्तामा आउँछ। त्यो आधारमा अर्को batch को बिरुवा छनोट हुन्छ।",
        "parentId": null
      },
      {
        "id": "b6e5d31b-d619-45d9-922f-bbeadcd28ca5",
        "memberSlug": "nisha",
        "text": "बच्चाहरूलाई पानी हाल्ने responsibility असाइन गऱ्यौँ — आउँदो ३ महिनासम्म साप्ताहिक schedule तयार छ।",
        "parentId": null
      },
      {
        "id": "c152fb48-64d2-40c5-b4db-87d69ff0c5fc",
        "memberSlug": "hari",
        "text": "मेरो जिम्मा हरेक आइतबार। SMS reminder आउँछ?",
        "parentId": "b6e5d31b-d619-45d9-922f-bbeadcd28ca5"
      },
      {
        "id": "2e6bd85e-4a8c-49d0-806e-e4ed496c7038",
        "memberSlug": "arjun",
        "text": "SMS reminder backend ले अझै handle गरेको छैन — manual whatsapp group ले अहिले replace गरेको छ।",
        "parentId": "b6e5d31b-d619-45d9-922f-bbeadcd28ca5"
      },
      {
        "id": "4b49ecaf-9880-48cf-94df-4b61a9b55817",
        "memberSlug": "kushal",
        "text": "Bhaktapur municipality को heritage committee पनि आज visit गर्न आउने रहेछन्। Coordination ramping up छ।",
        "parentId": null
      },
      {
        "id": "f55949c5-e9a4-4a77-8219-33b862dd3bc4",
        "memberSlug": "saraswati",
        "text": "साइनबोर्ड मा local language र English दुवै राख्ने योजना? तब टुरिस्टले पनि बिरुवाको नाम र महत्व बुझ्न सक्छन्।",
        "parentId": null
      },
      {
        "id": "b2a06fe1-ff3f-4104-af0c-c93396ee3906",
        "memberSlug": "bishnu",
        "text": "हो — bilingual सबै सूचना। मैले अघि draft पठाएको थिएँ।",
        "parentId": "f55949c5-e9a4-4a77-8219-33b862dd3bc4"
      },
      {
        "id": "b367db00-9a78-414c-b72e-4a67161fae5a",
        "memberSlug": "asmita",
        "text": "मेडिकल team मा कुनै emergency आयो भने Bhaktapur Hospital बाट ambulance ५ मिनेटमा pickup हुने commitment मिलेको रहेछ।",
        "parentId": null
      },
      {
        "id": "1522cf6f-ac9e-42bc-9c1c-3728390c4995",
        "memberSlug": "milan",
        "text": "धन्यवाद bishnu doctor — हिजो दिनभर बस्नुभयो, हिजो आजसम्म कुनै दुर्घटना छैन। यो organizing को quality हो।",
        "parentId": null
      },
      {
        "id": "f88248fe-ca6b-45f0-9407-b062dd876738",
        "memberSlug": "bishnu",
        "text": "Team को discipline को कारण हो। Hands-on लीडरशिप ले काम सजिलो बनाइदियो।",
        "parentId": "1522cf6f-ac9e-42bc-9c1c-3728390c4995"
      },
      {
        "id": "e9a45c94-6d08-40ae-90b8-aa3c10b93c64",
        "memberSlug": "naresh",
        "text": "Live stream को viewer count धेरै राम्रो छ — पहिलो दिन मात्र ३५० बढी viewer थिए। Geographical reach Australia, USA, Middle East बाट पनि।",
        "parentId": null
      },
      {
        "id": "e04072e0-7c8f-4e4c-a8c3-c313fbfe76a4",
        "memberSlug": "yamuna",
        "text": "Post-event का लागि photo collection को drive folder प्रत्येक participant ले upload गर्न सक्ने बनाउनुपर्छ। Memory archive long term value।",
        "parentId": null
      },
      {
        "id": "bb6b19e1-744f-4b6a-b34d-bbfd15e9824a",
        "memberSlug": "manish",
        "text": "मैले shared drive open गरें — group मा link पठायौँ।",
        "parentId": "e04072e0-7c8f-4e4c-a8c3-c313fbfe76a4"
      },
      {
        "id": "e79a8b7d-c90c-4c12-a004-b823e5761d0e",
        "memberSlug": "sandip",
        "text": "खाजाको quality र distribution flow पनि सहज छ — पन्जा र मास्क पनि सबैले उपयोग गरिरहेका छन्। Hygiene प्रोटोकल proper।",
        "parentId": null
      },
      {
        "id": "5ad61e65-0ac9-4b50-867a-a826fb6a09b2",
        "memberSlug": "kabita",
        "text": "Day 2 मा कति बिरुवा हुने अनुमान? Soil prep हिजो जति ज्यादा भयो — पानी पनि सजिलै सेच्न मिल्ने।",
        "parentId": null
      },
      {
        "id": "f797f44e-e7d6-48ed-a23a-fa8a52844e38",
        "memberSlug": "arjun",
        "text": "लक्ष्य 200 आज, total 300+ within next 36 hours। Materials supply pipeline ready छ।",
        "parentId": "5ad61e65-0ac9-4b50-867a-a826fb6a09b2"
      },
      {
        "id": "d9909a38-a047-433a-93c7-a304e070e283",
        "memberSlug": "rabindra",
        "text": "मेरो organization ले yearly CSR contribution यो अभियानमा लिने proposal अहिले bordroom मा छ। Update आउने बित्तिकै share गर्छु।",
        "parentId": null
      },
      {
        "id": "31a9911e-cc16-40e6-b86b-d3b026710d93",
        "memberSlug": "ishwori",
        "text": "Limbu, Tharu, Magar — हाम्रो टीम मा अहिले ५ different ethnic background का साथीहरू एकैसाथ काम गर्दैछौँ। यो साँच्चै beautiful मिसन हो।",
        "parentId": null
      },
      {
        "id": "5fa72d47-32e4-4a98-b856-85ba7d725d5f",
        "memberSlug": "suman",
        "text": "🌱 Diversity ले strength बनाउँछ। Photo opportunity पनि powerful छ।",
        "parentId": "31a9911e-cc16-40e6-b86b-d3b026710d93"
      },
      {
        "id": "393053f9-ab37-46ea-b46c-9c0f2f5822ac",
        "memberSlug": "subash",
        "text": "Tree-tagging GPS app proposal आज planning मा थियो — हरेक रोपिएको बिरुवालाई unique ID + lat/long record गर्ने। Maintenance ट्रयाक सजिलो।",
        "parentId": null
