  "comments": {
    "issue:shankhamul-bagmati-plastic": [
      {
        "id": "7cb2310f-02c1-4ae1-96db-acebf671059d",
        "memberSlug": "arjun",
        "text": "यो स्थानमा हामीले पहिले पनि अभियान चलाएका थियौँ — स्थायी समाधान चाहिएको हो। साइनबोर्डले मात्र पुग्दैन।"
      },
      {
        "id": "0685ff80-df01-4def-885b-beb49172a2dc",
        "memberSlug": "priya",
        "text": "मनसुनको पानी सँगै आउने प्लास्टिक रोक्न ने माथिल्लो खण्डमा छाननी लगाउनुपर्छ। नगरपालिकालाई सिफारिस गरौँ।"
      },
      {
        "id": "98ad4206-78e3-43da-9d9f-4e16b4a75de5",
        "memberSlug": "bishnu",
        "text": "अग्रिम अभियान चलाउनु अघि बासिन्दा बैठक राख्ने सुझाव।"
      },
      {
        "id": "b0def9fc-5533-42b8-b076-ecf2d4b3e193",
        "memberSlug": "sita",
        "text": "मेरो परिवारका सबै सहभागी हुन तयार छन्। शनिबार उपयुक्त हुनेछ।"
      }
    ],
    "issue:boudha-ring-road-trash": [
      {
        "id": "cb2ec2ba-2218-4fb8-83c6-e2825fc631f0",
        "memberSlug": "ramesh",
        "text": "मैले हिजो विडियो गरें — दृश्य साँच्चै खराब छ। टायर र पुराना सिमेन्ट पनि छन्।"
      },
      {
        "id": "5ad62412-d78d-44c8-992e-8fc040433588",
        "memberSlug": "bishnu",
        "text": "नगरपालिकाको ट्रक के बेला आउँछ निश्चित गरौँ — नभए सङ्कलित फोहोर त्यहीँ नै बस्छ।"
      },
      {
        "id": "768eeb80-d7ee-4a96-baeb-efec8b1bdf72",
        "memberSlug": "maya",
        "text": "व्यापार सङ्घले स्वयंसेवक पनि ल्याउने भनेका छन् भन्ने सुनेँ।"
      },
      {
        "id": "22e94a91-81fa-472c-b50c-a7e8be376e79",
        "memberSlug": "deepika",
        "text": "मैले हिजो साँझ Ring Road मा हिँडेर आउँदा देखेँ — Bouddha तर्फको दक्षिणी छेउ साँच्चै बिग्रिएको रहेछ। पर्यटक ओर्लिने ठाउँमै फोहोर जमेर बसेको छ।",
        "parentId": null
      },
      {
        "id": "d00b9827-9b2c-4aaf-a78c-0a14141e2a10",
        "memberSlug": "rajiv",
        "text": "साँच्चै। मेरो होटेल त्यहीँ छ; अतिथिले पहिलो दिन नै सोध्छन्।",
        "parentId": "22e94a91-81fa-472c-b50c-a7e8be376e79"
      },
      {
        "id": "773a2b0b-05ec-4e0b-b710-5f829abf17f0",
        "memberSlug": "nisha",
        "text": "नगरपालिकाको ट्रक हप्ताको एकपटक मात्र आउँछ कि भन्ने सुनेँ।",
        "parentId": "22e94a91-81fa-472c-b50c-a7e8be376e79"
      },
      {
        "id": "1f3b7255-700a-4f13-a61e-2eefe79f2314",
        "memberSlug": "rajiv",
        "text": "अहो, त्यसैले हो। आर्थिक रूपमा सहयोग गर्न पनि व्यापारीहरू तयार छन्।",
        "parentId": "773a2b0b-05ec-4e0b-b710-5f829abf17f0"
      },
      {
        "id": "c07b15f0-1d2e-40b2-8dde-f999031a0cc6",
        "memberSlug": "kushal",
        "text": "स्थानीय व्यापार सङ्घले पनि सहयोग गर्ने भनेका छन् — तर coordinate गर्ने एउटा point of contact चाहिएको रहेछ। श्रमदान ले त्यो भूमिका लिन सक्छ?",
        "parentId": null
      },
      {
        "id": "9096d97f-6859-4196-8270-1e669f696b8f",
        "memberSlug": "arjun",
        "text": "हुन्छ — coordinator role plan मा छ। तपाईंले अघि बढ्ने भए application पठाउनुहोस्।",
        "parentId": "c07b15f0-1d2e-40b2-8dde-f999031a0cc6"
      },
      {
        "id": "c8d2cbdc-cdba-420f-865f-d2f0c1702472",
        "memberSlug": "saraswati",
        "text": "Boudha Stupa भित्र-बाहिर सबै पर्यटक र भक्तजनको गन्तव्य हो। यो ठाउँको पहिलो प्रभाव खराब हुनु भनेको देशकै प्रतिष्ठाको कुरा हो।",
        "parentId": null
      },
      {
        "id": "95e463e1-403d-4e86-847c-94c63c08f772",
        "memberSlug": "naresh",
        "text": "मेरो परिवारको ४ जना सहभागी हुन तयार छन् — खाली शनिबार वा आइतबार उत्तम।",
        "parentId": null
      },
      {
        "id": "751c59d9-953c-417e-886b-7eb420ff7f5d",
        "memberSlug": "asmita",
        "text": "हाम्रो office team पनि CSR day मा यो अभियानमा जोडिन सक्छ। 20-25 जना अनुमानित।",
        "parentId": "95e463e1-403d-4e86-847c-94c63c08f772"
      },
      {
        "id": "82048f19-af79-4e35-9d47-9c4c353abbd1",
        "memberSlug": "milan",
        "text": "Plastic बिक्री गर्ने scrap dealer सँग पनि कुरा गरौँ — सङ्कलित प्लास्टिक उनीहरूले लग्न तयार छन् भने पुनःप्रयोग पनि हुन्छ।",
        "parentId": null
      },
      {
        "id": "734e5829-d0a8-45c6-84ec-8842a50d94b4",
        "memberSlug": "yamuna",
        "text": "मैले गत हप्ता तस्बिर खिचेर आफ्नो instagram मा पोस्ट गरेकी थिएँ — साथीहरूले reach out गरिरहेका छन् कसरी सहयोग गर्ने भनेर। पर्खाइ-पर्खाइको ठाउँ हो यो।",
        "parentId": null
      },
      {
        "id": "0f6aa32f-b9ee-434f-a2cb-1d2ab584dfdd",
        "memberSlug": "ramesh",
        "text": "तस्बिरको लिंक share गर्न मिल्छ? Live stream को content मा reference राख्न मिल्छ।",
        "parentId": "734e5829-d0a8-45c6-84ec-8842a50d94b4"
      },
      {
        "id": "b5f3c5c5-cbac-4778-a291-2b2d5082ffa3",
        "memberSlug": "yamuna",
        "text": "हुन्छ, DM गरेँ। Visual story powerful छ।",
        "parentId": "0f6aa32f-b9ee-434f-a2cb-1d2ab584dfdd"
      },
      {
        "id": "539a3185-c262-4b3a-96a4-213f04d378c3",
        "memberSlug": "sandip",
        "text": "Ring Road को यो खण्ड मेरो दैनिक commute मा पर्छ। सडक माथिको पुरानो टायर र building debris देख्दा साँच्चै दुख लाग्छ।",
        "parentId": null
      },
      {
        "id": "1a8570f3-84dd-4e4e-96e6-13630ab48582",
        "memberSlug": "kabita",
        "text": "महिला समूहले पनि coordinate गर्न सक्छन् — हाम्रो स्थानीय बैठकमा यो विषय उठाउँछौँ। 10-12 जना confirmed आउँछन्।",
        "parentId": null
      },
      {
        "id": "7e32f1fe-14db-4b28-9f84-cbd8da9594f1",
        "memberSlug": "rabindra",
        "text": "नगरपालिकाको permit लाई कस्तो process छ? मैले अघि incident plan पनि चाहिने भनेर सुनेको थिएँ।",
        "parentId": null
      },
      {
        "id": "73e41a77-e8b8-4f81-a401-2532e64d493e",
        "memberSlug": "priya",
        "text": "Safety lead role को क्षेत्र हो यो — मैले permit + insurance दुवै कुरा गर्दैछु। आउँदो साताभित्र clear हुन्छ।",
        "parentId": "7e32f1fe-14db-4b28-9f84-cbd8da9594f1"
      },
      {
        "id": "45a08de2-0fe8-4e07-9738-e4531a944c28",
        "memberSlug": "ishwori",
        "text": "Tharu Society Bouddha शाखाले पनि सहयोग गर्ने प्रतिज्ञा गरेका छन्। प्रत्येक सदस्यले औंलो छेउ बजाएर मिल्छु भन्ने जवाफ दिए।",
        "parentId": null
      },
      {
        "id": "efed0a4a-7d70-4fbe-a608-6b16f3b230bc",
        "memberSlug": "manish",
        "text": "Photographer/videographer छन् भने मलाई DM गर्नुहोस् — content team को coordination मेरो जिम्मा हो। Post-event recap video बनाउने योजना छ।",
        "parentId": null
      },
      {
        "id": "84ced838-c9e2-43be-a32b-8dccc350d2c1",
        "memberSlug": "maya",
        "text": "म PHOTOGRAPHER role मा apply गर्दैछु। Two cameras लिएर आउँछु।",
        "parentId": "efed0a4a-7d70-4fbe-a608-6b16f3b230bc"
      },
      {
        "id": "21c4d168-2c54-4022-9ceb-3a633e5e8b59",
        "memberSlug": "rojina",
        "text": "नगरपालिकाको bin व्यवस्थापन सुधार नभई दिगो समाधान आउँदैन। यो अभियानले त्यो दिशामा pressure पनि बनाउँछ।",
        "parentId": null
      },
      {
        "id": "f85c5d80-d316-49c7-ad62-125167ed0f6f",
        "memberSlug": "subash",
        "text": "Volunteer हरुलाई कस्तो dress code छ? Branded T-shirt? मैले अघिल्लो अभियानमा देखेँ छुट्टै रङ्गको थियो।",
        "parentId": null
      },
      {
        "id": "99e533ff-5213-4356-8476-02cf665c46ed",
        "memberSlug": "arjun",
        "text": "हो — हरियो polo त्यो दिनमा हामी सबैले लगाउँछौँ। Distribution venue मा हुन्छ।",
        "parentId": "f85c5d80-d316-49c7-ad62-125167ed0f6f"
      },
      {
        "id": "82ce4e89-bca2-4f03-9d13-48ee6b1b1ae2",
        "memberSlug": "anu",
        "text": "Drinking water + light snacks coordination मेरो जिम्मा लिन्छु। LOGISTICS role मा apply गर्दैछु — local supplier सँग tie-up पनि छ।",
        "parentId": null
      },
      {
        "id": "382305da-4132-4f97-a4cc-44b41099cd6b",
        "memberSlug": "krishna",
        "text": "Limbu Cultural Centre बाट volunteer हरु पठाउने tentative commitment छ। Final list यो हप्ताभित्रमा confirm हुन्छ।",
        "parentId": null
      },
      {
        "id": "d8545c0a-29f4-45e7-9685-9ff3e5f9ad71",
        "memberSlug": "arjun",
        "text": "🙏 Cross-community participation साँच्चै beautiful हुन्छ।",
        "parentId": "382305da-4132-4f97-a4cc-44b41099cd6b"
      }
    ],
